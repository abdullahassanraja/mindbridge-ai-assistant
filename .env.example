# MindBridge Wellness — Environment Configuration Template
# Copy this file to .env and supply your configuration

# API Server Configuration
PORT=8000
ALLOWED_ORIGIN=*

# Groq LLM Configuration (Optional: fallback deterministic engine used if omitted)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Qdrant Vector DB Configuration
# Local storage path:
QDRANT_PATH=../ingestion/qdrant_data

# Remote Qdrant Cloud (optional):
# QDRANT_URL=https://your-cluster-id.us-east-1.qdrant.tech:6333
# QDRANT_API_KEY=your_qdrant_api_key

# Google Sheets Integration (Service Account Auth)
# Path to service account credentials JSON file:
GOOGLE_SHEETS_CREDENTIALS_PATH=service_account.json
# Target Google Sheet Workbook ID (from spreadsheet URL):
GOOGLE_SHEETS_ID=your_google_sheet_id_here

# Microsoft Outlook SMTP Email Delivery Configuration
# Your Outlook email address (e.g., yourname@outlook.com or yourpractice@hotmail.com):
OUTLOOK_EMAIL=your_email@outlook.com
# Microsoft App Password (generated at https://account.live.com/proofs/manage/additional):
OUTLOOK_PASSWORD=your_outlook_app_password
# Where inquiry notification emails will be sent (defaults to OUTLOOK_EMAIL if omitted):
NOTIFICATION_EMAIL=your_email@outlook.com
# SMTP server & port (default: smtp-mail.outlook.com:587):
SMTP_SERVER=smtp-mail.outlook.com
SMTP_PORT=587
