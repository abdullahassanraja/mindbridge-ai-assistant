# MindBridge Wellness — Environment Configuration Template
# Copy this file to .env and supply your configuration

# API Server Configuration
PORT=8000
ALLOWED_ORIGIN=*

# Groq LLM Configuration (Optional: fallback deterministic engine used if omitted)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Qdrant Vector DB Configuration
# Local storage path:
QDRANT_PATH=../ingestion/qdrant_data

# Remote Qdrant Cloud (optional):
# QDRANT_URL=https://your-cluster-id.us-east-1.qdrant.tech:6333
# QDRANT_API_KEY=your_qdrant_api_key

# Google Sheets Integration (Service Account Auth)
# Path to service account credentials JSON file:
GOOGLE_SHEETS_CREDENTIALS_PATH=service_account.json
# Target Google Sheet Workbook ID (from spreadsheet URL):
GOOGLE_SHEETS_ID=your_google_sheet_id_here

# Email Notification Delivery Configuration
# Option 1: Resend HTTP API (Recommended for Render free tier - HTTPS port 443, never blocked)
RESEND_API_KEY=re_your_resend_api_key_here

# Option 2: Gmail SMTP (for local dev or hosting with unblocked SMTP port 587)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password
NOTIFICATION_EMAIL=your_email@gmail.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
