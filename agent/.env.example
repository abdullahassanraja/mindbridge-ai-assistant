# Groq API Key (required for live Groq LLM inference)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Recommended default fast general-purpose Groq model
GROQ_MODEL=openai/gpt-oss-120b

# Path to embedded local Qdrant vector database (relative to agent directory or absolute)
QDRANT_PATH=../ingestion/qdrant_data

# Optional: Remote Qdrant Cloud settings if not using local embedded Qdrant
# QDRANT_URL=https://your-cluster-id.us-east-1.qdrant.tech:6333
# QDRANT_API_KEY=your_qdrant_api_key_here
