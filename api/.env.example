# Server Port
PORT=8000

# CORS Allowed Origin (set to your Squarespace domain in production, e.g., https://mindbridgewellness.squarespace.com)
# Default is '*' for local testing, which prints a startup security warning
ALLOWED_ORIGIN=*

# Groq API Key (required for live Groq LLM reasoning)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Recommended default fast general-purpose Groq model
GROQ_MODEL=llama-3.3-70b-versatile

# Path to local embedded Qdrant vector database (relative to api folder or absolute)
QDRANT_PATH=../ingestion/qdrant_data

# Optional: Remote Qdrant Cloud settings if not using local embedded Qdrant
# QDRANT_URL=https://your-cluster-id.us-east-1.qdrant.tech:6333
# QDRANT_API_KEY=your_qdrant_api_key_here
