# Server Port
PORT=8000

# CORS Allowed Origin (set to your Squarespace domain in production, e.g., https://mindbridgewellness.squarespace.com)
# Default is '*' for local testing, which prints a startup security warning
ALLOWED_ORIGIN=*

# Groq API Key (required for live Groq LLM inference)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Recommended default fast general-purpose Groq model
GROQ_MODEL=openai/gpt-oss-120b

# Path to local embedded Qdrant vector database (relative to api folder or absolute)
QDRANT_PATH=../ingestion/qdrant_data

# Optional: Remote Qdrant Cloud settings if not using local embedded Qdrant
# QDRANT_URL=https://your-cluster-id.us-east-1.qdrant.tech:6333
# QDRANT_API_KEY=your_qdrant_api_key_here

# Google Sheets Integration (Service Account Auth)
# Path to service account credentials JSON file:
GOOGLE_SHEETS_CREDENTIALS_PATH=service_account.json
# Target Google Sheet Workbook ID (from spreadsheet URL):
GOOGLE_SHEETS_ID=your_google_sheet_id_here

# Microsoft Outlook SMTP Email Delivery Configuration
OUTLOOK_EMAIL=your_email@outlook.com
OUTLOOK_PASSWORD=your_outlook_app_password
NOTIFICATION_EMAIL=your_email@outlook.com
SMTP_SERVER=smtp-mail.outlook.com
SMTP_PORT=587
